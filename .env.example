# AllerGraph Configuration Example
# Copy this file to .env and configure your values

# Neo4j Database Configuration
# Default Bolt port is 7687 on localhost when running Neo4j in Docker on Linux host
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_your_actual_neo4j_password
NEO4J_DATABASE=neo4j

# Application Secrets
SESSION_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
CSRF_SECRET=replace_with_a_secure_random_csrf_secret

# Server Environment
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Optional SMTP Settings (for password reset emails in production)
# When not set, password reset instructions are logged securely to the development console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@allergraph.local
SMTP_TLS=True
